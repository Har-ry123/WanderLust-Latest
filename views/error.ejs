<% layout("layouts/boilerplate") %>
<section class="shell error-page">
    <p class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : 'Oops' %></p>
    <h1 class="page-title"><%= statusCode === 404 ? "We couldn't find that page" : 'Something went off course' %></h1>
    <p class="text-soft"><%= message %></p>
    <a href="/listings" class="btn btn-accent mt-2"><i class="fa-solid fa-compass me-2"></i>Back to exploring</a>
</section>
