<% layout("layouts/boilerplate") %>
<%
  const isEdit = 'new' === 'edit';
  const v = isEdit ? listing : {};
  const imageValue = isEdit ? (listing.image?.url || '') : '';
%>

<section class="shell form-page">
    <div class="form-head">
        <p class="eyebrow">Harry's Horizon</p>
        <h1 class="page-title"><%= isEdit ? 'Edit your listing' : 'Share your place with travellers' %></h1>
        <p class="text-soft"><%= isEdit ? 'Update the details guests see.' : 'A few details and a great photo are all it takes.' %></p>
    </div>

    <div class="form-layout">
        <form method="POST" action="<%= isEdit ? `/listings/${listing._id}?_method=PUT` : '/listings' %>" novalidate class="needs-validation form-card" data-listing-form>
            <div class="form-section">
                <h2 class="form-section-title"><span>1</span>The basics</h2>
                <div class="mb-3">
                    <label class="form-label" for="f-title">Title</label>
                    <input id="f-title" name="listing[title]" value="<%= v.title || '' %>" placeholder="e.g. Cliffside cottage with sea views" type="text" class="form-control" required data-preview="title" />
                    <div class="invalid-feedback">Give your place a title.</div>
                </div>
                <div class="mb-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0" for="f-description">Description</label>
                        <%- include("../includes/ai-write-button.ejs") %>
                    </div>
                    <textarea id="f-description" name="listing[description]" placeholder="What makes your place special?" class="form-control" rows="4" required><%= v.description || '' %></textarea>
                    <div class="invalid-feedback">Please add a short description.</div>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title"><span>2</span>Photo &amp; price</h2>
                <div class="mb-3">
                    <label class="form-label" for="f-image">Image link</label>
                    <input id="f-image" name="listing[image]" value="<%= imageValue %>" placeholder="https://example.com/photo.jpg" type="url" pattern="https?://.+" class="form-control" required data-preview="image" />
                    <div class="invalid-feedback">Please paste a valid image URL.</div>
                </div>
                <div>
                    <label class="form-label" for="f-price">Price per night</label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input id="f-price" name="listing[price]" value="<%= v.price ?? '' %>" placeholder="2500" type="number" min="0" class="form-control" required data-preview="price" />
                        <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title"><span>3</span>Location</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="f-location">City / area</label>
                        <input id="f-location" name="listing[location]" value="<%= v.location || '' %>" placeholder="e.g. Goa" type="text" class="form-control" required data-preview="location" />
                        <div class="invalid-feedback">Location is required.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="f-country">Country</label>
                        <input id="f-country" name="listing[country]" value="<%= v.country || '' %>" placeholder="e.g. India" type="text" class="form-control" required data-preview="country" />
                        <div class="invalid-feedback">Country is required.</div>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label">Pin it on the map</label>
                    <p class="text-soft small mb-2">Click the map or drag the pin to set the exact spot.</p>
                    <div id="map" class="map-container"></div>
                    <input type="hidden" name="listing[lng]" id="lng" value="<%= v.geometry?.coordinates?.[0] || '' %>">
                    <input type="hidden" name="listing[lat]" id="lat" value="<%= v.geometry?.coordinates?.[1] || '' %>">
                </div>
            </div>

            <div class="form-actions">
                <% if (isEdit) { %>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-ink">Cancel</a>
                <% } %>
                <button type="submit" class="btn btn-accent px-4"><%= isEdit ? 'Save changes' : 'Publish listing' %></button>
            </div>
        </form>

        <aside class="form-preview d-none d-lg-block">
            <p class="eyebrow mb-2">Live preview</p>
            <article class="stay-card">
                <div class="stay-media">
                    <img data-preview-img src="<%= imageValue || 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=900&q=60' %>" alt="Listing preview"
                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=900&q=60'" />
                </div>
                <div class="stay-body">
                    <div class="stay-row">
                        <h3 class="stay-place"><span data-preview-text="location"><%= v.location || 'Your city' %></span>, <span data-preview-text="country"><%= v.country || 'Country' %></span></h3>
                        <span class="stay-rating"><i class="fa-solid fa-star"></i>New</span>
                    </div>
                    <p class="stay-title" data-preview-text="title"><%= v.title || 'Your listing title' %></p>
                    <p class="stay-price"><strong>₹<span data-preview-text="price"><%= v.price ? v.price.toLocaleString('en-IN') : '0' %></span></strong> <span class="price-unit">night</span></p>
                </div>
            </article>
            <p class="text-soft small mt-3"><i class="fa-regular fa-lightbulb me-1"></i>Bright, wide photos get the most clicks.</p>
        </aside>
    </div>
</section>

<% if (mapboxToken) { %>
<% block('head').append('<link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">') %>
<% block('head').append('<link href="https://api.mapbox.com/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css" rel="stylesheet">') %>
<% block('scripts').append('<script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>') %>
<% block('scripts').append('<script src="https://api.mapbox.com/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js"></script>') %>
<% block('scripts').append('<script src="/js/geocode.js"></script>') %>
<% block('scripts').append('<script src="/js/mapForm.js"></script>') %>
<script>
    window.mapFormData = {
        token: <%- JSON.stringify(mapboxToken) %>,
        lng: '',
        lat: ''
    };
</script>
<% } else { %>
<% block('head').append('<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">') %>
<% block('scripts').append('<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>') %>
<% block('scripts').append('<script src="/js/leafletMap.js"></script>') %>
<script>
    window.leafletData = <%- JSON.stringify({ mode: 'form', lng: '', lat: '' }) %>;
</script>
<% } %>