<% layout("layouts/boilerplate") %>

<section class="ai-hero mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="ai-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> AI</span>
        <h5 class="mb-0">Describe your dream trip</h5>
    </div>
    <form action="/listings" method="GET" class="d-flex gap-2 flex-column flex-sm-row">
        <input type="text" name="ask" value="<%= ask %>" maxlength="300" class="form-control form-control-lg"
            placeholder="e.g. a cozy mountain cabin in the US under ₹2000 a night" <%= aiEnabled ? '' : 'disabled' %> />
        <button class="btn btn-danger btn-lg px-4 ai-submit" type="submit" <%= aiEnabled ? '' : 'disabled' %>>
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Find stays
        </button>
    </form>
    <% if (!aiEnabled) { %>
        <small class="text-muted d-block mt-2">AI search is off. Add <code>ANTHROPIC_API_KEY</code> to <code>major/.env</code> and restart the server to turn it on.</small>
    <% } %>
    <% if (aiSearch) { %>
        <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-muted small"><%= aiSearch.summary %></span>
            <% aiSearch.keywords.forEach((word) => { %><span class="badge rounded-pill text-bg-light border"><%= word %></span><% }) %>
            <% if (aiSearch.country) { %><span class="badge rounded-pill text-bg-light border"><i class="fa-solid fa-earth-asia me-1"></i><%= aiSearch.country %></span><% } %>
            <% if (aiSearch.minPrice != null) { %><span class="badge rounded-pill text-bg-light border">from ₹<%= aiSearch.minPrice.toLocaleString('en-IN') %></span><% } %>
            <% if (aiSearch.maxPrice != null) { %><span class="badge rounded-pill text-bg-light border">up to ₹<%= aiSearch.maxPrice.toLocaleString('en-IN') %></span><% } %>
            <a href="/listings" class="small ms-1">Clear</a>
        </div>
    <% } %>
</section>

<h3><%= aiSearch ? `${allListings.length} matching ${allListings.length === 1 ? 'stay' : 'stays'}` : 'All Listings' %></h3>
<% if (aiSearch && !allListings.length) { %>
    <p class="text-muted">Nothing matches that yet. Try loosening the budget or location.</p>
<% } %>

<div class="listings-container">
    <div class="listings-grid">
    <% for (let listing of allListings) {
        const imageUrl = listing?.image?.url || (typeof listing.image === 'string' ? listing.image : 'https://via.placeholder.com/600x400?text=No+Image');
    %>
        <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
            <div class="card listing-card h-100 shadow-sm border-0 overflow-hidden">
                <div class="card-img-wrapper position-relative">
                    <img src="<%= imageUrl %>" class="card-img-top" alt="<%= listing.title %>" />
                    <div class="img-overlay d-flex flex-column justify-content-between">
                        <span class="overlay-badge">Featured</span>
                        <div>
                            <h6 class="overlay-title mb-1"><%= listing.location %></h6>
                            <small><%= listing.country %></small>
                        </div>
                    </div>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-2"><%= listing.title %></h5>
                    <p class="card-text text-muted mb-3"><%= listing.description %></p>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">₹ <%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %></span>
                        <small class="text-muted">/ night</small>
                    </div>
                </div>
            </div>
        </a>
    <% } %>
    </div>
</div>

<!-- Mapbox scripts removed for main listings page -->

