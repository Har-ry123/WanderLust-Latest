# Optional: Mapbox maps. Without it the app uses free OpenStreetMap maps.
MAPBOX_TOKEN=
# Optional: turns on the AI features (smart search, description writer, trip planner).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: MongoDB Atlas URL (defaults to mongodb://127.0.0.1:27017/WanderLust)
ATLASDB_URL=
# Optional: session secret (set this in production)
SECRET=
