# Optional: Mapbox maps. Without it the app uses free OpenStreetMap maps.
MAPBOX_TOKEN=
# AI features are free by default:
#   - with Ollama running on this computer (https://ollama.com, then `ollama pull llama3.2`)
#     all AI features use that local model
#   - without it, smart search uses built-in rules and the writer uses a template
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434
# Optional, paid: use Claude instead (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Optional: MongoDB Atlas URL (defaults to mongodb://127.0.0.1:27017/WanderLust)
ATLASDB_URL=
# Optional: session secret (set this in production)
SECRET=
